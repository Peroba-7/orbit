# Painel do ORBIT (Streamlit): só lê a API por HTTP, não acessa o banco.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/srv
WORKDIR /srv

COPY requirements-painel.txt .
RUN pip install --no-cache-dir -r requirements-painel.txt

COPY painel ./painel

# Não roda como root dentro do contêiner.
RUN useradd --create-home orbit
USER orbit

EXPOSE 8501
# browser.serverAddress=localhost: o painel é acessado só pelo próprio computador
# e isso evita o Streamlit consultar um serviço externo para descobrir o IP público.
# gatherUsageStats=false: sem telemetria.
CMD ["python", "-m", "streamlit", "run", "painel/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", \
     "--browser.serverAddress=localhost", "--browser.gatherUsageStats=false"]
