# Copie para .env e preencha. O arquivo .env NUNCA vai para o GitHub.

# Chave que as fontes (e o painel) usam no cabeçalho X-API-Key. Gere uma longa e aleatória:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORBIT_CHAVE_API=troque-por-uma-chave-longa

# Senha do PostgreSQL usada pelo docker compose
ORBIT_BANCO_SENHA=troque-por-uma-senha-forte

# Fora do Docker, o padrão é SQLite local (orbit.db). Para usar PostgreSQL:
# ORBIT_BANCO_URL=postgresql+psycopg://orbit:SENHA@localhost:5432/orbit

# Janela de correlação em horas (padrão 24). Número positivo; aceita fração (0.5).
# ORBIT_JANELA_HORAS=24

# Saúde das fontes (etapa 4). Valor inválido cai no padrão (com aviso no log).
# Horas sem heartbeat até a fonte ser "silenciosa" (padrão 3; aceita fração):
# ORBIT_SILENCIO_HORAS=3
# Idade máxima da versão das regras, em dias inteiros (padrão 7):
# ORBIT_DESATUALIZACAO_DIAS=7
# De quantos em quantos minutos a API verifica a saúde das fontes (padrão 5;
# aceita fração; 0 desliga a verificação automática):
# ORBIT_VERIFICACAO_MINUTOS=5

# Painel (etapa 3). No Docker, o compose já aponta para http://api:8000.
# Fora do Docker, o padrão é a API local:
# ORBIT_API_URL=http://127.0.0.1:8000
